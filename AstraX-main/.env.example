# OpenRouter API key for assistant responses. Keep the real key in .env.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Optional OpenRouter model slug. Defaults to openai/gpt-4o-mini.
#OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# Optional; sent to OpenRouter as the HTTP-Referer header.
APP_URL="MY_APP_URL"
